# InsForge backend (get values from: npx @insforge/cli current --json)
VITE_INSFORGE_OSS_HOST=https://YOUR_APPKEY.YOUR_REGION.insforge.app
VITE_INSFORGE_ANON_KEY=ik_your_anon_key

# Login requires valid host + anon key. After first deploy, run insforge/bootstrap.sql
# (and ALTER for email if upgrading). To grant admin: register once, then run
# insforge/promote-admin.sql with your email (see file comments).
