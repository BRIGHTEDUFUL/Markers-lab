# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime.
APP_URL=https://ais-dev-xya7mstbbl56d4qgfgilvd-347026688553.europe-west2.run.app

# DATABASE_URL: Prisma database connection string.
# For local SQLite setup, use: "file:./prisma/dev.db"
DATABASE_URL="file:./prisma/dev.db"

# JWT_SECRET: Secret key for signing JSON Web Tokens.
# Configure this in the AI Studio Settings -> Secrets menu.
JWT_SECRET=
